<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="financa_homepage" model="website.page">
        <field name="name">Financa Consultores</field>
        <field name="type">qweb</field>
        <field name="key">financa_website.financa_homepage</field>
        <field name="url">/</field>
        <field name="website_id" search="[('domain', '=', '__FINANCA_DOMAIN__')]"/>
        <field name="is_published" eval="True"/>
        <field name="website_indexed" eval="True"/>
        <field name="track" eval="True"/>
        <field name="website_meta_title">Crecer con control | Financa Consultores</field>
        <field name="website_meta_description">Finanzas, negocio y tecnología para empresas que buscan tomar mejores decisiones, ordenar su operación y crecer con estructura y control.</field>
        <field name="arch" type="xml">
            <t name="Financa Consultores" t-name="financa_website.financa_homepage">
                <t t-call="website.layout">
                    <t t-set="additional_title">Crecer con control | Financa Consultores</t>
                    <!-- TEMPORADA: True durante el cierre de año. En enero cámbialo a False
                         (ver el bloque TEMPORADA de financa.scss y financa_season.js). -->
                    <t t-set="financa_season" t-value="True"/>
                    <div id="wrap" t-attf-class="financa-homepage #{'financa-season' if financa_season else ''} oe_structure">
                        <t t-call="financa_website.snippet_hero"/>
                        <t t-call="financa_website.snippet_problems"/>
                        <t t-call="financa_website.snippet_services"/>
                        <t t-call="financa_website.snippet_process"/>
                        <t t-call="financa_website.snippet_experience"/>
                        <t t-call="financa_website.snippet_final_cta"/>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <!-- Menus are attached to the root menu of the website selected by domain. -->
    <record id="menu_financa_services" model="website.menu">
        <field name="name">Ecosistema</field>
        <field name="url">/#ecosistema</field>
        <field name="sequence" eval="20"/>
        <field name="website_id" search="[('domain', '=', '__FINANCA_DOMAIN__')]"/>
        <field name="parent_id" search="[('website_id.domain', '=', '__FINANCA_DOMAIN__'), ('parent_id', '=', False)]"/>
    </record>
    <record id="menu_financa_odoo" model="website.menu">
        <field name="name">Odoo ERP</field>
        <field name="url">/#odoo-erp</field>
        <field name="sequence" eval="30"/>
        <field name="website_id" search="[('domain', '=', '__FINANCA_DOMAIN__')]"/>
        <field name="parent_id" search="[('website_id.domain', '=', '__FINANCA_DOMAIN__'), ('parent_id', '=', False)]"/>
    </record>
    <record id="menu_financa_diagnosis" model="website.menu">
        <field name="name">Diagnóstico</field>
        <field name="url">/#diagnostico</field>
        <field name="sequence" eval="40"/>
        <field name="website_id" search="[('domain', '=', '__FINANCA_DOMAIN__')]"/>
        <field name="parent_id" search="[('website_id.domain', '=', '__FINANCA_DOMAIN__'), ('parent_id', '=', False)]"/>
    </record>
    <record id="menu_financa_process" model="website.menu">
        <field name="name">Proceso</field>
        <field name="url">/#proceso</field>
        <field name="sequence" eval="50"/>
        <field name="website_id" search="[('domain', '=', '__FINANCA_DOMAIN__')]"/>
        <field name="parent_id" search="[('website_id.domain', '=', '__FINANCA_DOMAIN__'), ('parent_id', '=', False)]"/>
    </record>
    <record id="menu_financa_contact" model="website.menu">
        <field name="name">Contacto</field>
        <field name="url">/contactus</field>
        <field name="sequence" eval="60"/>
        <field name="website_id" search="[('domain', '=', '__FINANCA_DOMAIN__')]"/>
        <field name="parent_id" search="[('website_id.domain', '=', '__FINANCA_DOMAIN__'), ('parent_id', '=', False)]"/>
    </record>
    <record id="menu_financa_login" model="website.menu">
        <field name="name">Acceso a clientes</field>
        <field name="url">/web/login</field>
        <field name="sequence" eval="70"/>
        <field name="website_id" search="[('domain', '=', '__FINANCA_DOMAIN__')]"/>
        <field name="parent_id" search="[('website_id.domain', '=', '__FINANCA_DOMAIN__'), ('parent_id', '=', False)]"/>
    </record>

    <template id="layout_financa_header_class" inherit_id="website.layout" name="Financa Header Scope">
        <xpath expr="//header" position="attributes">
            <attribute name="t-attf-class" add="#{'financa-site-header' if website.domain == '__FINANCA_DOMAIN__' else ''}" separator=" "/>
        </xpath>
    </template>

    <!-- TEMPORADA: cinta sobre la cabecera; solo se pinta cuando la página define financa_season. -->
    <template id="layout_financa_season_ribbon" inherit_id="website.layout" name="Financa Season Ribbon">
        <xpath expr="//header" position="before">
            <div t-if="financa_season and website.domain == '__FINANCA_DOMAIN__'" class="financa-season-ribbon" role="region" aria-label="Mensaje de temporada">
                <div class="financa-container financa-season-ribbon-inner">
                    <svg class="financa-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2v20M2 12h20M5 5l14 14M19 5 5 19"/></svg>
                    <span>Felices fiestas de parte de FINANCA. Empieza 2027 con control.</span>
                    <a href="/contactus" data-financa-cta="1" data-financa-cta-name="agenda_diagnostico" data-financa-cta-location="temporada">Agenda tu diagnóstico</a>
                </div>
            </div>
            <!-- TEMPORADA: búho de la marca con gorro navideño. Se posa en una esquina inferior, vuela
                 aleteando al otro lado y aterriza (financa_season.js). Decorativo, no recibe clics.
                 La misma imagen se pinta tres veces y el CSS recorta ala izquierda, cuerpo y ala derecha. -->
            <div t-if="financa_season and website.domain == '__FINANCA_DOMAIN__'" class="financa-season-owl" data-financa-owl="1" data-side="left" aria-hidden="true">
                <div class="financa-season-owl-lift">
                    <div class="financa-season-owl-body">
                        <img class="financa-season-owl-part financa-season-owl-wing-left" src="/financa_website/static/src/img/buho_financa_dorado.png" alt="" width="256" height="166"/>
                        <img class="financa-season-owl-part financa-season-owl-wing-right" src="/financa_website/static/src/img/buho_financa_dorado.png" alt="" width="256" height="166"/>
                        <img class="financa-season-owl-part financa-season-owl-torso" src="/financa_website/static/src/img/buho_financa_dorado.png" alt="" width="256" height="166"/>
                        <svg class="financa-season-owl-hat" viewBox="0 0 64 44" focusable="false">
                            <path class="financa-season-owl-hat-cone" d="M11 33 Q19 5 41 7 Q56 9 57 27 Q48 15 37 33 Z"/>
                            <rect class="financa-season-owl-hat-trim" x="7" y="31" width="36" height="9" rx="4.5"/>
                            <circle class="financa-season-owl-hat-trim" cx="57" cy="29" r="5"/>
                        </svg>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="header_call_to_action_financa" inherit_id="website.header_call_to_action" name="Financa Header CTA">
        <xpath expr="//a[hasclass('btn_cta')]" position="attributes">
            <attribute name="t-if" add="website.domain != '__FINANCA_DOMAIN__'" separator=" and "/>
        </xpath>
        <xpath expr="//a[hasclass('btn_cta')]" position="before">
            <a t-if="website.domain == '__FINANCA_DOMAIN__'"
               href="/contactus"
               class="oe_unremovable btn btn-primary btn_cta financa-header-cta"
               data-financa-cta="1"
               data-financa-cta-name="solicitar_diagnostico"
               data-financa-cta-location="header">Solicitar diagnóstico</a>
        </xpath>
    </template>

    <template id="layout_financa_footer" inherit_id="website.layout" name="Financa Global Footer">
        <xpath expr="//footer[@id='bottom']" position="attributes">
            <attribute name="t-if" add="website.domain != '__FINANCA_DOMAIN__'" separator=" and "/>
        </xpath>
        <xpath expr="//footer[@id='bottom']" position="before">
            <footer t-if="website.domain == '__FINANCA_DOMAIN__' and not no_footer"
                    id="bottom" class="financa-footer o_footer">
                <div id="footer" class="oe_structure oe_structure_solo">
                    <section class="financa-footer-main" data-name="Financa Footer">
                        <div class="financa-container financa-footer-grid">
                            <div class="financa-footer-brand">
                                <a href="/" class="financa-footer-logo"><img src="/financa_website/static/src/img/logo_financa_dorado.png" alt="Financa Consultores" width="150" height="116" loading="lazy"/></a>
                                <p>Más que números. Más que contabilidad. Más que fiscal.</p>
                            </div>
                            <div>
                                <h3 class="financa-footer-heading">Soluciones</h3>
                                <ul>
                                    <li><a href="/#finanzas-negocio">Finanzas y negocio</a></li>
                                    <li><a href="/#fiscal-contabilidad">Fiscal y contabilidad</a></li>
                                    <li><a href="/#tecnologia-erp">Tecnología ERP</a></li>
                                    <li><a href="/#tecnologia">Integración y automatización</a></li>
                                    <li><a href="/#odoo-erp">Odoo ERP</a></li>
                                </ul>
                            </div>
                            <div>
                                <h3 class="financa-footer-heading">Empresa</h3>
                                <ul>
                                    <li><a href="/#problemas">Problemas que resolvemos</a></li>
                                    <li><a href="/#diagnostico">Diagnóstico</a></li>
                                    <li><a href="/#proceso">Cómo trabajamos</a></li>
                                    <li><a href="/contactus">Contacto</a></li>
                                    <li><a href="/web/login">Acceso a clientes</a></li>
                                </ul>
                            </div>
                            <div>
                                <h3 class="financa-footer-heading">Legal</h3>
                                <ul>
                                    <li><a href="/cookie-policy">Política de cookies</a></li>
                                    <li t-if="request.env['website.page'].sudo().search_count([('url', '=', '/aviso-de-privacidad'), ('website_id', '=', website.id), ('is_published', '=', True)])">
                                        <a href="/aviso-de-privacidad">Aviso de privacidad</a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </section>
                </div>
                <div class="financa-footer-bottom">
                    <div class="financa-container">&#169; <t t-out="datetime.date.today().year"/> Financa Consultores</div>
                </div>
            </footer>
        </xpath>
    </template>
</odoo>

