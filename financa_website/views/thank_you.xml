<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="financa_thank_you_page" model="website.page">
        <field name="name">Gracias por solicitar un diagnóstico</field>
        <field name="type">qweb</field>
        <field name="key">financa_website.financa_thank_you_page</field>
        <field name="url">/gracias-diagnostico</field>
        <field name="website_id" search="[('domain', '=', '__FINANCA_DOMAIN__')]"/>
        <field name="is_published" eval="True"/>
        <field name="website_indexed" eval="False"/>
        <field name="website_meta_title">Gracias por contactarnos | Financa Consultores</field>
        <field name="arch" type="xml">
            <t name="Gracias por solicitar un diagnóstico" t-name="financa_website.financa_thank_you_page">
                <t t-call="website.layout">
                    <t t-set="no_index" t-value="True"/>
                    <div id="wrap" class="financa-thank-you oe_structure" data-financa-thank-you="diagnostico">
                        <section class="financa-section">
                            <div class="financa-container financa-thank-you-card">
                                <span class="financa-thank-you-icon" aria-hidden="true">✓</span>
                                <h1>Gracias por contactarnos</h1>
                                <p>Recibimos tu solicitud. Un consultor la revisará y te contactará en un plazo no mayor a <strong>72 horas</strong>.</p>
                                <ul class="financa-thank-you-steps">
                                    <li>En breve recibirás en tu correo una confirmación de seguimiento.</li>
                                    <li>Ese correo incluye un breve cuestionario para conocer mejor tu caso; responderlo nos ayuda a preparar tu diagnóstico.</li>
                                </ul>
                                <p class="financa-thank-you-note">¿No lo ves? Revisa tu carpeta de spam o correo no deseado.</p>
                                <a href="/" class="financa-button financa-button-primary">Volver al inicio</a>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <record id="contactus_page_financa_route" model="website.page">
        <field name="name">Contacto</field>
        <field name="type">qweb</field>
        <field name="key">financa_website.contactus_page_financa_route</field>
        <field name="url">/contactus</field>
        <field name="website_id" search="[('domain', '=', '__FINANCA_DOMAIN__')]"/>
        <field name="is_published" eval="True"/>
        <field name="website_meta_title">Contacto | Financa Consultores</field>
        <field name="website_meta_description">Cuéntanos sobre tu empresa. Financa Consultores te ayuda a ordenar finanzas, operación y tecnología para crecer con control.</field>
        <field name="arch" type="xml">
            <t name="Contacto" t-name="financa_website.contactus_page_financa_route">
                <!-- TEMPORADA: cinta y nevada también en contacto; en enero pásalo a False. -->
                <t t-set="financa_season" t-value="True"/>
                <t t-call="website.contactus"/>
            </t>
        </field>
    </record>

    <record id="contactus_page_financa" model="ir.ui.view">
        <field name="name">Financa Contact Page Styling</field>
        <field name="key">financa_website.contactus_page_financa</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="website.contactus"/>
        <field name="website_id" search="[('domain', '=', '__FINANCA_DOMAIN__')]"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='wrap']" position="attributes">
                <attribute name="class" add="financa-contact" separator=" "/>
            </xpath>
            <xpath expr="//section[hasclass('s_title')]" position="attributes">
                <attribute name="class" add="financa-contact-hero" separator=" "/>
            </xpath>
            <xpath expr="//section[hasclass('s_text_block')]//div[hasclass('offset-lg-1')]" position="attributes">
                <attribute name="class" add="financa-contact-info" separator=" "/>
            </xpath>
        </field>
    </record>

    <record id="contactus_form_financa" model="ir.ui.view">
        <field name="name">Financa Contact Form Tracking and Redirect</field>
        <field name="key">financa_website.contactus_form_financa</field>
        <field name="type">qweb</field>
        <field name="inherit_id" ref="website.contactus"/>
        <field name="website_id" search="[('domain', '=', '__FINANCA_DOMAIN__')]"/>
        <field name="arch" type="xml">
            <xpath expr="//form[@id='contactus_form']" position="attributes">
                <attribute name="data-success-mode">redirect</attribute>
                <attribute name="data-success-page">/gracias-diagnostico?financa_submission=1</attribute>
                <attribute name="data-financa-form-name">contacto_diagnostico</attribute>
                <!-- crea un lead en CRM (website_crm) en vez de un correo interno; el lead dispara el seguimiento -->
                <attribute name="data-model_name">crm.lead</attribute>
            </xpath>
            <!-- nombres de campo de crm.lead; "name" pasa a ser el asunto (título del lead) -->
            <xpath expr="//form[@id='contactus_form']//input[@name='name']" position="attributes">
                <attribute name="name">contact_name</attribute>
            </xpath>
            <xpath expr="//form[@id='contactus_form']//input[@name='company']" position="attributes">
                <attribute name="name">partner_name</attribute>
            </xpath>
            <xpath expr="//form[@id='contactus_form']//input[@name='subject']" position="attributes">
                <attribute name="name">name</attribute>
            </xpath>
            <!-- email_to solo aplica a mail.mail -->
            <xpath expr="//form[@id='contactus_form']//input[@name='email_to']/ancestor::div[hasclass('s_website_form_field')][1]" position="replace"/>
        </field>
    </record>
</odoo>

