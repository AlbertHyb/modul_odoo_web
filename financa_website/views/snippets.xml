<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Homepage "Gala de cierre de año".
        Las partes de temporada dependen de la variable QWeb `financa_season`
        (se define en views/homepage.xml). Con financa_season en False la página
        muestra la versión permanente: sin tarjeta de cierre, sin cinta, sin nieve
        y con los textos no estacionales.
    -->
    <template id="snippet_hero" name="Hero Financa">
        <section class="financa-hero" data-snippet="financa_website.snippet_hero" data-name="Hero Financa" data-financa-section="hero">
            <div class="financa-container financa-hero-grid">
                <div class="financa-hero-copy">
                    <p class="financa-eyebrow">
                        <t t-if="financa_season">Cierre 2026 · Arranque 2027</t>
                        <t t-else="">Finanzas · Fiscal y Contabilidad · ERP · Integración y Automatización</t>
                    </p>
                    <h1>
                        <t t-if="financa_season">Cierra el año con control. <em>Empieza el siguiente con estructura.</em></t>
                        <t t-else="">Crecer es importante. <em>Crecer con control es indispensable.</em></t>
                    </h1>
                    <p class="financa-hero-lead">Finanzas, negocio y tecnología para empresas que buscan tomar mejores decisiones, ordenar su operación y crecer con estructura.</p>
                    <div class="financa-actions">
                        <a href="/contactus" class="financa-button financa-button-primary" data-financa-cta="1" data-financa-cta-name="hablemos_empresa" data-financa-cta-location="hero">Hablemos de tu empresa <svg class="financa-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                        <a href="#ecosistema" class="financa-button financa-button-secondary" data-financa-cta="1" data-financa-cta-name="conoce_financa" data-financa-cta-location="hero">Conoce FINANCA</a>
                    </div>
                </div>
                <!-- temporada: tarjeta de cierre de año con contador de días -->
                <aside t-if="financa_season" class="financa-ledger" aria-label="Antes de cerrar el año">
                    <p class="financa-ledger-count"><strong data-financa-days="1" t-out="(datetime.date(datetime.date.today().year, 12, 31) - datetime.date.today()).days"/><span>días para cerrar el año</span></p>
                    <h2>Lo que conviene tener claro antes del 31 de diciembre</h2>
                    <ul>
                        <li><svg class="financa-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12.5 10 17 19 7"/></svg><div><strong>Flujo proyectado</strong>Saber con qué recursos arranca enero.</div></li>
                        <li><svg class="financa-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12.5 10 17 19 7"/></svg><div><strong>Inventario conciliado</strong>Existencias, movimientos y costos con certeza.</div></li>
                        <li><svg class="financa-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12.5 10 17 19 7"/></svg><div><strong>Obligaciones anticipadas</strong>Fiscal y nómina atendidos antes de que urjan.</div></li>
                        <li><svg class="financa-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12.5 10 17 19 7"/></svg><div><strong>Reportes para decidir</strong>Información que llega antes de la decisión.</div></li>
                    </ul>
                    <p class="financa-ledger-note">Lista orientativa. El diagnóstico define lo que aplica a tu empresa.</p>
                </aside>
            </div>
        </section>
    </template>

    <template id="snippet_problems" name="El dolor">
        <section id="problemas" class="financa-section financa-paper financa-problems financa-reveal" data-snippet="financa_website.snippet_problems" data-name="El dolor" data-financa-section="problemas">
            <div class="financa-container financa-index-grid">
                <div class="financa-index-intro">
                    <p class="financa-eyebrow">El dolor</p>
                    <h2>¿Tu empresa está creciendo, pero también crece el desorden?</h2>
                    <p>El crecimiento necesita estructura. <strong>FINANCA ayuda a conectar las piezas.</strong></p>
                </div>
                <ol class="financa-index-list">
                    <li><span class="financa-num">01</span><h3>Información que llega tarde</h3><p>Los reportes llegan cuando la decisión ya se tomó.</p></li>
                    <li><span class="financa-num">02</span><h3>Procesos desconectados</h3><p>Cada área trabaja por su lado y la información no fluye.</p></li>
                    <li><span class="financa-num">03</span><h3>Inventarios difíciles de controlar</h3><p>No hay certeza sobre existencias, movimientos ni costos.</p></li>
                    <li><span class="financa-num">04</span><h3>Decisiones con información incompleta</h3><p>Se decide con datos parciales o desactualizados.</p></li>
                    <li><span class="financa-num">05</span><h3>Obligaciones fiscales que no se anticipan</h3><p>Se atienden cuando ya urgen, no antes.</p></li>
                    <li><span class="financa-num">06</span><h3>Sistemas que no se comunican</h3><p>Las herramientas no se hablan y el equipo hace el trabajo a mano.</p></li>
                </ol>
            </div>
        </section>
    </template>

    <template id="snippet_services" name="Ecosistema Financa">
        <section id="ecosistema" class="financa-section financa-ink financa-ecosystem financa-reveal" data-snippet="financa_website.snippet_services" data-name="Ecosistema Financa" data-financa-section="ecosistema">
            <div class="financa-container">
                <div class="financa-section-heading">
                    <p class="financa-eyebrow">El ecosistema Financa</p>
                    <h2>Una empresa. Una visión integral.</h2>
                </div>
                <div class="financa-bento">
                    <article id="tecnologia-erp" class="financa-tile financa-tile-lead" data-financa-section="odoo_erp">
                        <div>
                            <span class="financa-num">Tecnología ERP</span>
                            <h3 id="odoo-erp">Odoo ERP</h3>
                        </div>
                        <div>
                            <p>La tecnología debe convertir la operación en información. Implementamos, optimizamos y rescatamos Odoo desde una perspectiva financiera y empresarial.</p>
                            <ol class="financa-chain" aria-label="Flujo que conectamos">
                                <li><span>Ventas</span></li><li><span>Compras</span></li><li><span>Inventario</span></li><li><span>Operación</span></li><li><span>Finanzas</span></li>
                            </ol>
                        </div>
                    </article>
                    <article id="finanzas-negocio" class="financa-tile">
                        <span class="financa-num">01</span>
                        <h3>Finanzas y negocio</h3>
                        <p>Planeación, rentabilidad, flujo, presupuestos y estrategia.</p>
                    </article>
                    <article id="fiscal-contabilidad" class="financa-tile">
                        <span class="financa-num">02</span>
                        <h3>Fiscal y contabilidad</h3>
                        <p>Contabilidad, fiscal, nómina, SIROC, riesgos y cumplimiento.</p>
                    </article>
                    <article id="tecnologia" class="financa-tile financa-tile-wide" data-financa-section="tecnologia">
                        <span class="financa-num">04</span>
                        <h3 id="integracion-automatizacion">Integración y automatización</h3>
                        <p>Cuando los sistemas no hablan entre sí, las personas terminan haciendo el trabajo. Conectamos ERP, plataformas, APIs y datos.</p>
                        <ul class="financa-tags"><li>Integración</li><li>Automatización</li><li>Desarrollo</li><li>IA aplicada</li></ul>
                    </article>
                </div>
            </div>
        </section>
    </template>

    <template id="snippet_process" name="Método Financa">
        <section id="proceso" class="financa-section financa-paper financa-method financa-reveal" data-snippet="financa_website.snippet_process" data-name="Método Financa" data-financa-section="proceso">
            <div class="financa-container">
                <div class="financa-rail-head">
                    <div>
                        <p class="financa-eyebrow">Método Financa</p>
                        <h2>Entendemos la empresa antes de proponer la solución.</h2>
                    </div>
                    <p>No comenzamos por un software, una declaración ni un reporte. <strong>Comenzamos entendiendo cómo funciona tu negocio.</strong></p>
                </div>
                <ol class="financa-rail">
                    <li><span class="financa-num">01</span><h3>Diagnóstico</h3><p>Entendemos tu empresa.</p></li>
                    <li><span class="financa-num">02</span><h3>Diseño</h3><p>Definimos la solución.</p></li>
                    <li><span class="financa-num">03</span><h3>Implementación</h3><p>La llevamos a la operación.</p></li>
                    <li><span class="financa-num">04</span><h3>Información</h3><p>Construimos información útil y confiable.</p></li>
                    <li><span class="financa-num">05</span><h3>Decisión</h3><p>La convertimos en control y acción.</p></li>
                </ol>
            </div>
        </section>
    </template>

    <template id="snippet_experience" name="Experiencia Financa">
        <section id="experiencia" class="financa-section financa-ink financa-experience financa-reveal" data-snippet="financa_website.snippet_experience" data-name="Experiencia Financa" data-financa-section="experiencia">
            <div class="financa-container">
                <div class="financa-section-heading">
                    <p class="financa-eyebrow">Experiencia</p>
                    <h2>Experiencia que se convierte en criterio.</h2>
                </div>
                <ul class="financa-stats">
                    <li><strong data-count="30" data-count-prefix="+" data-count-suffix=" años">+30 años</strong><span>Fiscal y contabilidad</span></li>
                    <li><strong data-count="25" data-count-prefix="+">+25</strong><span>Dirección empresarial</span></li>
                    <li><strong data-count="20" data-count-prefix="+">+20</strong><span>Planeación financiera</span></li>
                    <li><strong data-count="15" data-count-prefix="+">+15</strong><span>Estructuración empresarial</span></li>
                    <li><strong data-count="10" data-count-prefix="+">+10</strong><span>Implementaciones ERP</span></li>
                </ul>
                <ul id="casos" class="financa-cases" aria-label="Casos" data-financa-section="casos">
                    <li><h3>Multisucursal</h3><p>Finanzas + Inventario + Odoo</p></li>
                    <li><h3>Empresa comercial</h3><p>Integración + Automatización</p></li>
                    <li><h3>Empresa en crecimiento</h3><p>Planeación financiera + Estructura</p></li>
                </ul>
            </div>
        </section>
    </template>

    <template id="snippet_final_cta" name="CTA Financa">
        <section id="diagnostico" class="financa-section financa-closing financa-reveal" data-snippet="financa_website.snippet_final_cta" data-name="CTA Financa" data-financa-section="cta_final">
            <div class="financa-container financa-closing-inner">
                <div>
                    <p class="financa-eyebrow">
                        <t t-if="financa_season"><svg class="financa-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3 6 11h3l-4 6h14l-4-6h3zM12 17v4"/></svg>Propósito 2027</t>
                        <t t-else="">El cierre</t>
                    </p>
                    <h2>Tu empresa puede crecer. La pregunta es si está creciendo con control.</h2>
                    <p>
                        <t t-if="financa_season">FINANCA puede ayudarte a encontrar la respuesta antes de que empiece el año.</t>
                        <t t-else="">FINANCA puede ayudarte a encontrar la respuesta.</t>
                    </p>
                </div>
                <a href="/contactus" class="financa-button financa-button-primary" data-financa-cta="1" data-financa-cta-name="hablemos_empresa" data-financa-cta-location="cta_final">Hablemos de tu empresa</a>
            </div>
        </section>
    </template>

    <template id="snippets" inherit_id="website.snippets" name="Financa Building Blocks">
        <xpath expr="//snippets[@id='snippet_structure']/*[1]" position="before">
            <t t-snippet="financa_website.snippet_hero" string="Hero Financa">
                <keywords>Financa hero consultoría</keywords>
            </t>
            <t t-snippet="financa_website.snippet_problems" string="El dolor">
                <keywords>Financa problemas dolor</keywords>
            </t>
            <t t-snippet="financa_website.snippet_services" string="Ecosistema Financa">
                <keywords>Financa ecosistema capacidades Odoo ERP integración</keywords>
            </t>
            <t t-snippet="financa_website.snippet_process" string="Método Financa">
                <keywords>Financa método propuesta pasos</keywords>
            </t>
            <t t-snippet="financa_website.snippet_experience" string="Experiencia Financa">
                <keywords>Financa experiencia años casos</keywords>
            </t>
            <t t-snippet="financa_website.snippet_final_cta" string="CTA Financa">
                <keywords>Financa llamada acción diagnóstico</keywords>
            </t>
        </xpath>
    </template>
</odoo>
