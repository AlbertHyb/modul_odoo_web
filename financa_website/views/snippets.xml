<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="snippet_hero" name="Hero Financa">
        <section class="financa-hero" data-snippet="financa_website.snippet_hero" data-name="Hero Financa" data-financa-section="hero">
            <div class="financa-container financa-hero-grid">
                <div class="financa-hero-copy">
                    <p class="financa-eyebrow">Finanzas · Negocio · Tecnología</p>
                    <h1>Consultoría empresarial para crecer con control, estructura y tecnología</h1>
                    <p class="financa-hero-lead">Transformamos información financiera y operativa en decisiones claras, conectando estrategia, procesos y tecnología para mejorar el control, la rentabilidad y el crecimiento</p>
                    <div class="financa-actions">
                        <a href="/contactus" class="financa-button financa-button-primary" data-financa-cta="1" data-financa-cta-name="solicitar_diagnostico" data-financa-cta-location="hero">Solicitar diagnóstico</a>
                        <a href="#servicios" class="financa-button financa-button-secondary" data-financa-cta="1" data-financa-cta-name="conocer_soluciones" data-financa-cta-location="hero">Conocer nuestras soluciones</a>
                    </div>
                </div>
                <div class="financa-hero-carousel" role="region" aria-roledescription="carrusel" aria-label="Soluciones integrales Financa" tabindex="0">
                    <div class="financa-hero-panels">
                        <article class="financa-dashboard financa-hero-panel" role="group" aria-roledescription="diapositiva" aria-label="1 de 3: Control y decisiones">
                            <div class="financa-dashboard-header">
                                <div>
                                    <span class="financa-dashboard-dot" aria-hidden="true"/>
                                    <span class="financa-dashboard-dot" aria-hidden="true"/>
                                    <span class="financa-dashboard-dot" aria-hidden="true"/>
                                </div>
                                <span>Visión del negocio</span>
                            </div>
                            <h2>Control y decisiones</h2>
                            <div class="financa-dashboard-grid">
                                <article><span>Ventas</span><strong data-count="18" data-count-prefix="+" data-count-suffix="%">+18%</strong><small>Crecimiento y rentabilidad</small></article>
                                <article><span>Finanzas</span><strong>Reportes listos</strong><small>Información para decidir</small></article>
                                <article><span>Operación</span><strong data-count="6" data-count-suffix=" alertas">6 alertas</strong><small>Procesos bajo control</small></article>
                                <article><span>Comercial</span><strong data-count="24" data-count-suffix=" oportunidades">24 oportunidades</strong><small>Seguimiento visible</small></article>
                            </div>
                            <p class="financa-illustrative-note">Cifras únicamente ilustrativas; no representan datos reales.</p>
                        </article>
                        <article class="financa-hero-panel" role="group" aria-roledescription="diapositiva" aria-label="2 de 3: Empresa conectada">
                            <p class="financa-hero-panel-kicker">Un solo flujo de información</p>
                            <h2>Empresa conectada</h2>
                            <ol class="financa-connected-flow">
                                <li>Ventas</li><li>Finanzas</li><li>Compras</li><li>Inventarios / Operación</li><li>Contabilidad</li><li>Dirección</li>
                            </ol>
                        </article>
                        <article class="financa-hero-panel" role="group" aria-roledescription="diapositiva" aria-label="3 de 3: Tecnología adecuada">
                            <p class="financa-hero-panel-kicker">Capacidades que se adaptan</p>
                            <h2>Tecnología adecuada</h2>
                            <ul class="financa-tech-grid">
                                <li>ERP</li><li>Automatización</li><li>Integraciones</li><li>Desarrollo a medida</li><li>Inteligencia Artificial</li><li>Analítica de datos</li>
                            </ul>
                        </article>
                    </div>
                    <div class="financa-carousel-controls" aria-label="Controles del carrusel">
                        <button type="button" class="financa-carousel-arrow" data-financa-carousel-prev="1" aria-label="Mostrar panel anterior">&#8592;</button>
                        <div class="financa-carousel-dots" aria-label="Elegir panel">
                            <button type="button" data-financa-carousel-dot="0" aria-label="Mostrar Control y decisiones" aria-current="true"/>
                            <button type="button" data-financa-carousel-dot="1" aria-label="Mostrar Empresa conectada" aria-current="false"/>
                            <button type="button" data-financa-carousel-dot="2" aria-label="Mostrar Tecnología adecuada" aria-current="false"/>
                        </div>
                        <button type="button" class="financa-carousel-arrow" data-financa-carousel-next="1" aria-label="Mostrar panel siguiente">&#8594;</button>
                    </div>
                    <p class="financa-visually-hidden" data-financa-carousel-status="1" aria-live="polite" aria-atomic="true"/>
                </div>
            </div>
        </section>
    </template>

    <template id="snippet_problems" name="Problemas que resolvemos">
        <section id="problemas" class="financa-section financa-problems financa-reveal" data-snippet="financa_website.snippet_problems" data-name="Problemas que resolvemos" data-financa-section="problemas">
            <div class="financa-container">
                <div class="financa-section-heading">
                    <p class="financa-eyebrow">Problemas que resolvemos</p>
                    <h2>Cuando el negocio crece, la información también debe estar bajo control.</h2>
                </div>
                <ul class="financa-problems-grid">
                    <li class="financa-problem"><span class="financa-icon" aria-hidden="true"><i class="fa fa-database"/></span><p><strong>Información dispersa</strong> Cada área maneja sus datos por separado y nadie tiene una sola versión de la verdad.</p></li>
                    <li class="financa-problem"><span class="financa-icon" aria-hidden="true"><i class="fa fa-keyboard-o"/></span><p><strong>Tareas manuales</strong> El equipo dedica horas a capturar y copiar información que ya existe en otro lugar.</p></li>
                    <li class="financa-problem"><span class="financa-icon" aria-hidden="true"><i class="fa fa-eye-slash"/></span><p><strong>Falta de visibilidad</strong> Es difícil saber con certeza cómo está el negocio en un momento dado.</p></li>
                    <li class="financa-problem"><span class="financa-icon" aria-hidden="true"><i class="fa fa-chain-broken"/></span><p><strong>Sistemas desconectados</strong> Las herramientas no se hablan entre sí y la información no fluye de un área a otra.</p></li>
                    <li class="financa-problem"><span class="financa-icon" aria-hidden="true"><i class="fa fa-clock-o"/></span><p><strong>Reportes tardíos</strong> Los informes llegan cuando la decisión ya se tomó, o no llegan.</p></li>
                    <li class="financa-problem"><span class="financa-icon" aria-hidden="true"><i class="fa fa-line-chart"/></span><p><strong>Crecimiento sin procesos</strong> El negocio crece, pero la forma de trabajar no crece con él.</p></li>
                    <li class="financa-problem"><span class="financa-icon" aria-hidden="true"><i class="fa fa-tachometer"/></span><p><strong>Falta de indicadores</strong> No hay una forma clara de medir resultados ni de saber qué está funcionando.</p></li>
                    <li class="financa-problem"><span class="financa-icon" aria-hidden="true"><i class="fa fa-file-excel-o"/></span><p><strong>Dependencia de Excel</strong> Las decisiones dependen de hojas de cálculo que se actualizan a mano.</p></li>
                </ul>
            </div>
        </section>
    </template>

    <template id="snippet_services" name="Servicios Financa">
        <section id="servicios" class="financa-section financa-services financa-reveal" data-snippet="financa_website.snippet_services" data-name="Servicios Financa" data-financa-section="servicios">
            <div class="financa-container">
                <div class="financa-section-heading">
                    <p class="financa-eyebrow">Una visión integral</p>
                    <h2>Servicios</h2>
                    <p>Resultados que se notan en la operación: más control, decisiones más rápidas y una empresa que crece sobre una base sólida.</p>
                </div>
                <div class="financa-services-grid">
                    <article class="financa-card financa-service-card">
                        <span class="financa-icon" aria-hidden="true">01</span>
                        <h3>Finanzas y negocio</h3>
                        <p>Claridad sobre rentabilidad, costos y capital de trabajo para decidir con confianza y crecer con control.</p>
                    </article>
                    <article class="financa-card financa-service-card">
                        <span class="financa-icon" aria-hidden="true">02</span>
                        <h3>Contabilidad y fiscal</h3>
                        <p>Cumplimiento al día y una lectura útil de los números para anticipar y decidir con oportunidad.</p>
                    </article>
                    <article class="financa-card financa-service-card">
                        <span class="financa-icon" aria-hidden="true">03</span>
                        <h3>Tecnología empresarial</h3>
                        <p>Sistemas que conectan la operación y transforman datos dispersos en información accionable.</p>
                    </article>
                    <article class="financa-card financa-service-card">
                        <span class="financa-icon" aria-hidden="true">04</span>
                        <h3>Automatización e inteligencia artificial</h3>
                        <p>Menos trabajo repetitivo y más tiempo para lo que genera valor: tus clientes y tu operación.</p>
                    </article>
                </div>
            </div>
        </section>
    </template>

