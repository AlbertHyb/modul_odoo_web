<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="snippet_hero" name="Hero Financa">
        <section class="financa-hero" data-snippet="financa_website.snippet_hero" data-name="Hero Financa" data-financa-section="hero">
            <div class="financa-container financa-hero-grid">
                <div class="financa-hero-copy">
                    <p class="financa-eyebrow">Finanzas · Fiscal y Contabilidad · ERP · Integración y Automatización</p>
                    <h1>Crecer es importante. Crecer con control es indispensable.</h1>
                    <p class="financa-hero-lead">Finanzas, negocio y tecnología para empresas que buscan tomar mejores decisiones, ordenar su operación y crecer con estructura.</p>
                    <div class="financa-actions">
                        <a href="/contactus" class="financa-button financa-button-primary" data-financa-cta="1" data-financa-cta-name="hablemos_empresa" data-financa-cta-location="hero">Hablemos de tu empresa</a>
                        <a href="#ecosistema" class="financa-button financa-button-secondary" data-financa-cta="1" data-financa-cta-name="conoce_financa" data-financa-cta-location="hero">Conoce FINANCA</a>
                    </div>
                </div>
                <div class="financa-hero-carousel" role="region" aria-roledescription="carrusel" aria-label="Soluciones integrales Financa" tabindex="0">
                    <div class="financa-hero-panels">
                        <article class="financa-dashboard financa-hero-panel" role="group" aria-roledescription="diapositiva" aria-label="1 de 3: Control y decisiones">
                            <div class="financa-dashboard-header">
                                <div>
                                    <span class="financa-dashboard-dot" aria-hidden="true"/>
                                    <span class="financa-dashboard-dot" aria-hidden="true"/>
                                    <span class="financa-dashboard-dot" aria-hidden="true"/>
                                </div>
                                <span>Visión del negocio</span>
                            </div>
                            <h2>Control y decisiones</h2>
                            <div class="financa-dashboard-grid">
                                <article><span>Ventas</span><strong data-count="18" data-count-prefix="+" data-count-suffix="%">+18%</strong><small>Crecimiento y rentabilidad</small></article>
                                <article><span>Finanzas</span><strong>Reportes listos</strong><small>Información para decidir</small></article>
                                <article><span>Operación</span><strong data-count="6" data-count-suffix=" alertas">6 alertas</strong><small>Procesos bajo control</small></article>
                                <article><span>Comercial</span><strong data-count="24" data-count-suffix=" oportunidades">24 oportunidades</strong><small>Seguimiento visible</small></article>
                            </div>
                            <p class="financa-illustrative-note">Cifras únicamente ilustrativas; no representan datos reales.</p>
                        </article>
                        <article class="financa-hero-panel" role="group" aria-roledescription="diapositiva" aria-label="2 de 3: Empresa conectada">
                            <p class="financa-hero-panel-kicker">Un solo flujo de información</p>
                            <h2>Empresa conectada</h2>
                            <ol class="financa-connected-flow">
                                <li>Ventas</li><li>Finanzas</li><li>Compras</li><li>Inventarios / Operación</li><li>Contabilidad</li><li>Dirección</li>
                            </ol>
                        </article>
                        <article class="financa-hero-panel" role="group" aria-roledescription="diapositiva" aria-label="3 de 3: Ecosistema Financa">
                            <p class="financa-hero-panel-kicker">El ecosistema Financa</p>
                            <h2>Una visión integral</h2>
                            <ul class="financa-tech-grid">
                                <li>Finanzas y negocio</li><li>Fiscal y contabilidad</li><li>Tecnología ERP</li><li>Integración y automatización</li>
                            </ul>
                        </article>
                    </div>
                    <div class="financa-carousel-controls" aria-label="Controles del carrusel">
                        <button type="button" class="financa-carousel-arrow" data-financa-carousel-prev="1" aria-label="Mostrar panel anterior">&#8592;</button>
                        <div class="financa-carousel-dots" aria-label="Elegir panel">
                            <button type="button" data-financa-carousel-dot="0" aria-label="Mostrar Control y decisiones" aria-current="true"/>
                            <button type="button" data-financa-carousel-dot="1" aria-label="Mostrar Empresa conectada" aria-current="false"/>
                            <button type="button" data-financa-carousel-dot="2" aria-label="Mostrar Ecosistema Financa" aria-current="false"/>
                        </div>
                        <button type="button" class="financa-carousel-arrow" data-financa-carousel-next="1" aria-label="Mostrar panel siguiente">&#8594;</button>
                    </div>
                    <p class="financa-visually-hidden" data-financa-carousel-status="1" aria-live="polite" aria-atomic="true"/>
                </div>
            </div>
        </section>
    </template>

    <template id="snippet_problems" name="El dolor">
        <section id="problemas" class="financa-section financa-problems financa-reveal" data-snippet="financa_website.snippet_problems" data-name="El dolor" data-financa-section="problemas">
            <div class="financa-container">
                <div class="financa-section-heading">
                    <p class="financa-eyebrow">El dolor</p>
                    <h2>¿Tu empresa está creciendo… pero también está creciendo el desorden?</h2>
                </div>
                <ul class="financa-problems-grid">
                    <li class="financa-problem"><span class="financa-icon" aria-hidden="true"><i class="fa fa-clock-o"/></span><p><strong>Información que llega tarde</strong> Los reportes llegan cuando la decisión ya se tomó.</p></li>
                    <li class="financa-problem"><span class="financa-icon" aria-hidden="true"><i class="fa fa-chain-broken"/></span><p><strong>Procesos desconectados</strong> Cada área trabaja por su lado y la información no fluye.</p></li>
                    <li class="financa-problem"><span class="financa-icon" aria-hidden="true"><i class="fa fa-database"/></span><p><strong>Inventarios difíciles de controlar</strong> No hay certeza sobre existencias, movimientos ni costos.</p></li>
                    <li class="financa-problem"><span class="financa-icon" aria-hidden="true"><i class="fa fa-eye-slash"/></span><p><strong>Decisiones con información incompleta</strong> Se decide con datos parciales o desactualizados.</p></li>
                    <li class="financa-problem"><span class="financa-icon" aria-hidden="true"><i class="fa fa-file-excel-o"/></span><p><strong>Obligaciones fiscales que no se anticipan</strong> Se atienden cuando ya urgen, no antes.</p></li>
                    <li class="financa-problem"><span class="financa-icon" aria-hidden="true"><i class="fa fa-keyboard-o"/></span><p><strong>Sistemas que no se comunican</strong> Las herramientas no se hablan y el equipo hace el trabajo a mano.</p></li>
                </ul>
                <p class="financa-problems-closing">El crecimiento necesita estructura. <strong>FINANCA ayuda a conectar las piezas.</strong></p>
            </div>
        </section>
    </template>

    <template id="snippet_services" name="Ecosistema Financa">
        <section id="ecosistema" class="financa-section financa-services financa-reveal" data-snippet="financa_website.snippet_services" data-name="Ecosistema Financa" data-financa-section="ecosistema">
            <div class="financa-container">
                <div class="financa-section-heading">
                    <p class="financa-eyebrow">El ecosistema Financa</p>
                    <h2>Una empresa. Una visión integral.</h2>
                </div>
                <div class="financa-services-grid">
                    <article class="financa-card financa-service-card">
                        <span class="financa-icon" aria-hidden="true">01</span>
                        <h3>Finanzas y negocio</h3>
                        <p>Planeación, rentabilidad, flujo, presupuestos y estrategia.</p>
                    </article>
                    <article class="financa-card financa-service-card">
                        <span class="financa-icon" aria-hidden="true">02</span>
                        <h3>Fiscal y contabilidad</h3>
                        <p>Contabilidad, fiscal, nómina, SIROC, riesgos y cumplimiento.</p>
                    </article>
                    <article class="financa-card financa-service-card">
                        <span class="financa-icon" aria-hidden="true">03</span>
                        <h3>Tecnología ERP</h3>
                        <p>Odoo, implementación, optimización y rescate.</p>
                    </article>
                    <article class="financa-card financa-service-card">
                        <span class="financa-icon" aria-hidden="true">04</span>
                        <h3>Integración y automatización</h3>
                        <p>APIs, sistemas, automatización, IA y datos.</p>
