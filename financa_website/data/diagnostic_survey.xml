    <record id="financa_diagnostic_q_areas_a4" model="survey.question.answer">
        <field name="question_id" ref="financa_diagnostic_q_areas"/>
        <field name="sequence">40</field>
        <field name="value">Inventarios y almacén</field>
    </record>
    <record id="financa_diagnostic_q_areas_a5" model="survey.question.answer">
        <field name="question_id" ref="financa_diagnostic_q_areas"/>
