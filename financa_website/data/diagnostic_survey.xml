<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cuestionario que recibe por correo cada solicitud de diagnóstico.
         Se versiona aquí: los cambios hechos en Odoo se sobrescriben al actualizar el módulo. -->
    <record id="financa_diagnostic_survey" model="survey.survey">
        <field name="title">Cuestionario de diagnóstico Financa</field>
        <field name="survey_type">survey</field>
        <field name="access_mode">token</field>
        <field name="is_attempts_limited" eval="True"/>
        <field name="attempts_limit">1</field>
        <field name="users_can_go_back" eval="True"/>
        <field name="questions_layout">one_page</field>
        <field name="progression_mode">percent</field>
        <field name="description" type="html">
            <p>Estas preguntas nos ayudan a preparar tu diagnóstico antes de la primera llamada. Responderlas toma unos 3 minutos.</p>
        </field>
        <field name="description_done" type="html">
            <p>Gracias. Con tus respuestas prepararemos el diagnóstico y te contactaremos en un plazo no mayor a 72 horas.</p>
        </field>
    </record>

    <record id="financa_diagnostic_q_industry" model="survey.question">
        <field name="survey_id" ref="financa_diagnostic_survey"/>
        <field name="sequence">10</field>
        <field name="title">¿A qué giro se dedica tu empresa?</field>
        <field name="question_type">simple_choice</field>
        <field name="constr_mandatory" eval="True"/>
        <field name="constr_error_msg">Esta pregunta es obligatoria.</field>
        <field name="comments_allowed" eval="True"/>
        <field name="comment_count_as_answer" eval="True"/>
        <field name="comments_message">Otro (especifica)</field>
    </record>
    <record id="financa_diagnostic_q_industry_a1" model="survey.question.answer">
        <field name="question_id" ref="financa_diagnostic_q_industry"/>
        <field name="sequence">10</field>
        <field name="value">Comercio (mayoreo o menudeo)</field>
    </record>
    <record id="financa_diagnostic_q_industry_a2" model="survey.question.answer">
        <field name="question_id" ref="financa_diagnostic_q_industry"/>
        <field name="sequence">20</field>
        <field name="value">Manufactura o producción</field>
    </record>
    <record id="financa_diagnostic_q_industry_a3" model="survey.question.answer">
        <field name="question_id" ref="financa_diagnostic_q_industry"/>
        <field name="sequence">30</field>
        <field name="value">Servicios profesionales</field>
    </record>
    <record id="financa_diagnostic_q_industry_a4" model="survey.question.answer">
        <field name="question_id" ref="financa_diagnostic_q_industry"/>
        <field name="sequence">40</field>
        <field name="value">Distribución y logística</field>
    </record>
    <record id="financa_diagnostic_q_industry_a5" model="survey.question.answer">
        <field name="question_id" ref="financa_diagnostic_q_industry"/>
        <field name="sequence">50</field>
        <field name="value">Construcción o inmobiliario</field>
    </record>
    <record id="financa_diagnostic_q_industry_a6" model="survey.question.answer">
        <field name="question_id" ref="financa_diagnostic_q_industry"/>
        <field name="sequence">60</field>
        <field name="value">Alimentos y restaurantes</field>
    </record>

    <record id="financa_diagnostic_q_team_size" model="survey.question">
        <field name="survey_id" ref="financa_diagnostic_survey"/>
        <field name="sequence">20</field>
        <field name="title">¿Cuántas personas trabajan en tu empresa?</field>
        <field name="question_type">simple_choice</field>
        <field name="constr_mandatory" eval="True"/>
        <field name="constr_error_msg">Esta pregunta es obligatoria.</field>
    </record>
    <record id="financa_diagnostic_q_team_size_a1" model="survey.question.answer">
        <field name="question_id" ref="financa_diagnostic_q_team_size"/>
        <field name="sequence">10</field>
        <field name="value">1 a 10</field>
    </record>
    <record id="financa_diagnostic_q_team_size_a2" model="survey.question.answer">
        <field name="question_id" ref="financa_diagnostic_q_team_size"/>
        <field name="sequence">20</field>
        <field name="value">11 a 50</field>
    </record>
    <record id="financa_diagnostic_q_team_size_a3" model="survey.question.answer">
        <field name="question_id" ref="financa_diagnostic_q_team_size"/>
        <field name="sequence">30</field>
        <field name="value">51 a 200</field>
    </record>
    <record id="financa_diagnostic_q_team_size_a4" model="survey.question.answer">
        <field name="question_id" ref="financa_diagnostic_q_team_size"/>
        <field name="sequence">40</field>
        <field name="value">Más de 200</field>
    </record>

    <record id="financa_diagnostic_q_revenue" model="survey.question">
        <field name="survey_id" ref="financa_diagnostic_survey"/>
        <field name="sequence">30</field>
        <field name="title">¿Cuál es la facturación anual aproximada?</field>
        <field name="question_type">simple_choice</field>
        <field name="constr_mandatory" eval="False"/>
    </record>
    <record id="financa_diagnostic_q_revenue_a1" model="survey.question.answer">
        <field name="question_id" ref="financa_diagnostic_q_revenue"/>
        <field name="sequence">10</field>
        <field name="value">Menos de 5 millones de pesos</field>
    </record>
    <record id="financa_diagnostic_q_revenue_a2" model="survey.question.answer">
        <field name="question_id" ref="financa_diagnostic_q_revenue"/>
        <field name="sequence">20</field>
        <field name="value">De 5 a 20 millones de pesos</field>
    </record>
    <record id="financa_diagnostic_q_revenue_a3" model="survey.question.answer">
        <field name="question_id" ref="financa_diagnostic_q_revenue"/>
        <field name="sequence">30</field>
        <field name="value">De 20 a 100 millones de pesos</field>
    </record>
    <record id="financa_diagnostic_q_revenue_a4" model="survey.question.answer">
        <field name="question_id" ref="financa_diagnostic_q_revenue"/>
        <field name="sequence">40</field>
        <field name="value">Más de 100 millones de pesos</field>
    </record>
    <record id="financa_diagnostic_q_revenue_a5" model="survey.question.answer">
        <field name="question_id" ref="financa_diagnostic_q_revenue"/>
        <field name="sequence">50</field>
        <field name="value">Prefiero no decirlo</field>
    </record>

    <record id="financa_diagnostic_q_systems" model="survey.question">
        <field name="survey_id" ref="financa_diagnostic_survey"/>
        <field name="sequence">40</field>
        <field name="title">¿Qué herramientas usan hoy para administrar la operación?</field>
        <field name="question_type">multiple_choice</field>
        <field name="constr_mandatory" eval="True"/>
        <field name="constr_error_msg">Esta pregunta es obligatoria.</field>
        <field name="comments_allowed" eval="True"/>
        <field name="comment_count_as_answer" eval="True"/>
        <field name="comments_message">Otro (especifica)</field>
    </record>
    <record id="financa_diagnostic_q_systems_a1" model="survey.question.answer">
        <field name="question_id" ref="financa_diagnostic_q_systems"/>
        <field name="sequence">10</field>
