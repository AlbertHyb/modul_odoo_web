COMPOSE_PROJECT_NAME=financa_production
ODOO_IMAGE=odoo@sha256:REPLACE_WITH_APPROVED_ODOO_19_DIGEST
POSTGRES_IMAGE=postgres@sha256:REPLACE_WITH_APPROVED_POSTGRES_DIGEST
POSTGRES_DB=financa_production
POSTGRES_USER=odoo
POSTGRES_PASSWORD_FILE=/etc/financa-production/secrets/postgres_password
POSTGRES_DATA_DIR=/srv/financa-production/data/postgres
ODOO_DATA_DIR=/srv/financa-production/data/odoo
ODOO_CONFIG_FILE=/etc/financa-production/odoo.conf
FINANCA_RELEASE_DIR=/srv/financa-production/releases/current/financa_website
ODOO_PORT=8069
TZ=America/Mexico_City
