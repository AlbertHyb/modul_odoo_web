# Copy to /etc/financa-production/deploy.env; owner root:root, mode 0600.
REPO_USER=ubuntu
PRODUCTION_DOMAIN=https://REPLACE_WITH_PRODUCTION_DOMAIN
ODOO_DB=financa_production
ODOO_PORT=8069
COMPOSE_ENV_FILE=/etc/financa-production/compose.env
COMPOSE_FILE=/etc/financa-production/compose.yaml
FINANCA_VERIFY_BIN=/usr/local/sbin/verify-financa-artifact
REQUIRE_GA4=true
FINANCA_BACKUP_BIN=/usr/local/sbin/financa-production-r2-backup
FINANCA_RESTORE_BIN=/usr/local/sbin/financa-production-r2-restore
R2_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
R2_PREFIX=financa-production
R2_AWS_PROFILE=financa-production
