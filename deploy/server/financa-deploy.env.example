# Copy to /etc/financa/deploy.env on the server and restrict it to root.
ODOO_BIN=/opt/odoo/odoo-bin
ODOO_CONFIG=/etc/odoo/odoo.conf
ODOO_DB=financa_production
ODOO_ADDONS_DIR=/opt/odoo/custom-addons
ODOO_SERVICE=odoo
ODOO_USER=odoo
ODOO_GROUP=odoo

# The deployment never selects a website by name alone.
FINANCA_DOMAIN=https://financa-mx

# Keep true in production. Set false only in an environment where GA4 is not expected.
REQUIRE_GA4=true

