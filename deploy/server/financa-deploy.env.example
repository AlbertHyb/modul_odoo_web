# Copy to /etc/financa/deploy.env on the server and restrict it to root.
ODOO_BIN=/opt/odoo/odoo-bin
ODOO_CONFIG=/etc/odoo/odoo.conf
ODOO_DB=financa_production
ODOO_ADDONS_DIR=/opt/odoo/custom-addons
ODOO_SERVICE=odoo
ODOO_USER=odoo
ODOO_GROUP=odoo

# The deployment never selects a website by name alone.
FINANCA_DOMAIN=https://financa-mx

# Keep true in production. Set false only in an environment where GA4 is not expected.
REQUIRE_GA4=true

# Mandatory recovery hooks. Both must be canonical, root-owned executables and
# must not be writable by group or others.
# Backup contract:  financa-backup <database>
#                   prints one opaque recovery token after saving DB + filestore.
# Restore contract: financa-restore <database> <recovery-token>
#                   restores DB + filestore to that same point.
FINANCA_BACKUP_BIN=/usr/local/sbin/financa-backup
FINANCA_RESTORE_BIN=/usr/local/sbin/financa-restore

